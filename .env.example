OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
# Seconds x 1000 before an OpenRouter call gives up (default 180000).
OPENROUTER_TIMEOUT_MS=180000
COMFYUI_URL=http://127.0.0.1:8188

# Optional: ComfyUI output folder on this machine (comparisons read videos from disk instead of ComfyUI /view)
COMFYUI_OUTPUT_DIR=

# ComfyUI Logs window (bottom of every page). Without these it reads <ComfyUI>/user/comfyui.log next to COMFYUI_OUTPUT_DIR.
# Full path of the log file to show (wins over everything else).
# COMFYUI_LOG_PATH=
# The ComfyUI folder; the log is <COMFYUI_PATH>/user/comfyui.log.
# COMFYUI_PATH=
# Where the window's settings are kept (default .data/comfy-log-viewer.json).
# COMFY_LOG_VIEWER_SETTINGS_PATH=
